{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "strict": true, "noEmit": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true, "skipLibCheck": true
  },
  "include": ["src"]
}
